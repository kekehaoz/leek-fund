{
  "name": "data-lens",
  "displayName": "Data Lens",
  "description": "轻量数据透镜，提供实时指标、趋势分析与侧栏数据视图",
  "version": "3.25.0",
  "author": "Nicky Lao <giscafer@outlook.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/LeekHub/leek-fund"
  },
  "license": "BSD-3-Clause",
  "keywords": [
    "stock",
    "fund",
    "LeekFund",
    "股票",
    "基金",
    "韭菜盒子",
    "同花顺",
    "东方财富",
    "天天基金"
  ],
  "publisher": "giscafer",
  "icon": "resources/logo.png",
  "engines": {
    "vscode": "^1.59.0"
  },
  "enableProposedAPI": false,
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:data-lens.refreshStock",
    "onCommand:data-lens.stockWindVane",
    "onCommand:data-lens.refreshFund",
    "onView:dataLensView.fund",
    "onView:dataLensView.stock",
    "onView:dataLensView.news",
    "onView:dataLensView.binance",
    "onView:dataLensView.forex",
    "onView:dataLensView.settings",
    "onCommand:data-lens.toggleStatusBarIconVisibility"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dataLensMenu",
          "title": "Data Lens",
          "icon": "resources/leekfund.svg"
        }
      ]
    },
    "views": {
      "dataLensMenu": [
        {
          "id": "dataLensView.fund",
          "name": "Fund"
        },
        {
          "id": "dataLensView.stock",
          "name": "Stock"
        },
        {
          "id": "dataLensView.news",
          "name": "XueQiu News"
        },
        {
          "id": "dataLensView.binance",
          "name": "Binance",
          "visibility": "hidden"
        },
        {
          "id": "dataLensView.forex",
          "name": "Forex",
          "visibility": "hidden"
        },
        {
          "id": "dataLensView.settings",
          "visibility": "visible",
          "name": "Settings"
        }
      ]
    },
    "commands": [
      {
        "command": "data-lens.openAiConfig",
        "title": "Data Lens: 打开 AI 配置管理",
        "icon": "$(gear)"
      },
      {
        "command": "data-lens.viewFundRank",
        "title": "基金排行榜",
        "icon": {
          "light": "resources/light/rank.svg",
          "dark": "resources/dark/rank.svg"
        }
      },
      {
        "command": "data-lens.viewFundTrend",
        "title": "基金走势一览",
        "icon": {
          "light": "resources/light/trend.svg",
          "dark": "resources/dark/trend.svg"
        }
      },
      {
        "command": "data-lens.sortFund",
        "title": "升序/降序/不排序",
        "icon": {
          "light": "resources/light/sort.svg",
          "dark": "resources/dark/sort.svg"
        }
      },
      {
        "command": "data-lens.sortAmountFund",
        "title": "持仓金额升序/降序",
        "icon": {
          "light": "resources/light/amount-sort.svg",
          "dark": "resources/dark/amount-sort.svg"
        }
      },
      {
        "command": "data-lens.addFund",
        "title": "添加基金",
        "icon": "$(add)"
      },
      {
        "command": "data-lens.addFundGroup",
        "title": "添加分组",
        "icon": "$(diff-added)"
      },
      {
        "command": "data-lens.setFundAmount",
        "title": "设置基金持仓金额",
        "icon": {
          "light": "resources/light/amount.svg",
          "dark": "resources/dark/amount.svg"
        }
      },
      {
        "command": "data-lens.setFundTop",
        "title": "基金置顶",
        "icon": {
          "light": "resources/light/top.svg",
          "dark": "resources/dark/top.svg"
        }
      },
      {
        "command": "data-lens.deleteFund",
        "title": "删除基金"
      },
      {
        "command": "data-lens.viewFundHistory",
        "title": "历史净值"
      },
      {
        "command": "data-lens.viewFundPosition",
        "title": "持仓信息"
      },
      {
        "command": "data-lens.removeFundGroup",
        "title": "删除分组"
      },
      {
        "command": "data-lens.renameFundGroup",
        "title": "修改分组名称"
      },
      {
        "command": "data-lens.refreshFund",
        "title": "刷新数据",
        "icon": "$(refresh)"
      },
      {
        "command": "data-lens.sortStock",
        "title": "升序/降序/不排序",
        "icon": {
          "light": "resources/light/sort.svg",
          "dark": "resources/dark/sort.svg"
        }
      },
      {
        "command": "data-lens.addStock",
        "title": "添加股票",
        "icon": "$(add)"
      },
      {
        "command": "data-lens.setStockPrice",
        "title": "设置股票成本价",
        "icon": {
          "light": "resources/light/amount.svg",
          "dark": "resources/dark/amount.svg"
        }
      },
      {
        "command": "data-lens.leekCenterView",
        "title": "韭菜中心",
        "icon": "$(home)"
      },
      {
        "command": "data-lens.refreshStock",
        "title": "刷新数据",
        "icon": "$(refresh)"
      },
      {
        "command": "data-lens.setStockTop",
        "title": "股票置顶",
        "icon": {
          "light": "resources/light/top.svg",
          "dark": "resources/dark/top.svg"
        }
      },
      {
        "command": "data-lens.setStockUp",
        "title": "股票上移",
        "icon": "$(arrow-up)"
      },
      {
        "command": "data-lens.setStockDown",
        "title": "股票下移",
        "icon": "$(arrow-down)"
      },
      {
        "command": "data-lens.deleteStock",
        "title": "删除股票"
      },
      {
        "command": "data-lens.aiStockAnalysis",
        "title": "AI分析股票（A股搜狐/港股腾讯 前复权日线，含快讯与韭研）",
        "icon": "$(lightbulb)"
      },
      {
        "command": "data-lens.addStockToBar",
        "title": "添加至状态栏"
      },
      {
        "command": "data-lens.addSectorIndex",
        "title": "添加板块指数",
        "icon": "$(add)"
      },
      {
        "command": "data-lens.deleteSectorIndex",
        "title": "删除板块指数"
      },
      {
        "command": "data-lens.setSectorTop",
        "title": "板块指数置顶",
        "icon": {
          "light": "resources/light/top.svg",
          "dark": "resources/dark/top.svg"
        }
      },
      {
        "command": "data-lens.stockTrendPic",
        "title": "股票走势（图片版）"
      },
      {
        "command": "data-lens.viewFundFlow",
        "title": "资金流向",
        "icon": {
          "light": "resources/light/flow.svg",
          "dark": "resources/dark/flow.svg"
        }
      },
      {
        "command": "data-lens.refreshFollow",
        "title": "刷新关注列表",
        "icon": "$(refresh)"
      },
      {
        "command": "data-lens.toggleFlashNews",
        "title": "启用/关闭 OUTPUT Flash News",
        "icon": {
          "light": "resources/light/news.svg",
          "dark": "resources/dark/news.svg"
        }
      },
      {
        "command": "data-lens.toggleStockChanges",
        "title": "启用/关闭 OUTPUT 盘口异动",
        "icon": "$(pulse)"
      },
      {
        "command": "data-lens.stock-changes-show",
        "title": "显示盘口异动输出"
      },
      {
        "command": "data-lens.addNews",
        "title": "添加关注雪球用户",
        "icon": "$(add)"
      },
      {
        "command": "data-lens.viewUserTimeline",
        "title": "查看动态（无头像）"
      },
      {
        "command": "data-lens.deleteUser",
        "title": "取消关注"
      },
      {
        "command": "data-lens.addBinancePair",
        "title": "添加交易对",
        "icon": "$(add)"
      },
      {
        "command": "data-lens.deletePair",
        "title": "删除交易对"
      },
      {
        "command": "data-lens.refreshBinance",
        "title": "刷新数据",
        "icon": "$(refresh)"
      },
      {
        "command": "data-lens.setPairTop",
        "title": "交易对置顶",
        "icon": {
          "light": "resources/light/top.svg",
          "dark": "resources/dark/top.svg"
        }
      },
      {
        "command": "data-lens.refreshForex",
        "title": "刷新数据",
        "icon": "$(refresh)"
      },
      {
        "command": "data-lens.toggleStatusBarVisibility",
        "title": "Data Lens: Toggle Status Bar Visibility"
      },
      {
        "command": "data-lens.toggleStatusBarIconVisibility",
        "title": "Data Lens: Toggle Status Bar Icon Visibility"
      },
      {
        "command": "data-lens.toggleFundBarVisibility",
        "title": "Data Lens: Toggle Fund Bar Visibility"
      },
      {
        "command": "data-lens.toggleStockBarVisibility",
        "title": "Data Lens: Toggle Stock Bar Visibility"
      },
      {
        "command": "data-lens.binanceSort",
        "title": "升序/降序/不排序",
        "icon": {
          "light": "resources/light/sort.svg",
          "dark": "resources/dark/sort.svg"
        }
      },
      {
        "command": "data-lens.xuangubaoNews",
        "title": "选股宝快讯",
        "icon": {
          "light": "resources/light/news.svg",
          "dark": "resources/dark/news.svg"
        }
      },
      {
        "command": "data-lens.stockWindVane",
        "title": "选股风向标",
        "icon": "$(graph)"
      }
    ],
    "keybindings": [
      {
        "command": "data-lens.toggleStatusBarVisibility",
        "key": "ctrl+alt+t",
        "mac": "cmd+alt+t"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "data-lens.viewFundTrend",
          "when": "view == dataLensView.fund",
          "group": "navigation"
        },
        {
          "command": "data-lens.viewFundRank",
          "when": "view == dataLensView.fund",
          "group": "navigation"
        },
        {
          "command": "data-lens.refreshFund",
          "when": "view == dataLensView.fund",
          "group": "navigation"
        },
        {
          "command": "data-lens.sortFund",
          "when": "view == dataLensView.fund",
          "group": "navigation"
        },
        {
          "command": "data-lens.sortAmountFund",
          "when": "view == dataLensView.fund",
          "group": "navigation"
        },
        {
          "command": "data-lens.addFundGroup",
          "when": "view == dataLensView.fund",
          "group": "navigation"
        },
        {
          "command": "data-lens.setFundAmount",
          "when": "view == dataLensView.fund",
          "group": "navigation"
        },
        {
          "command": "data-lens.refreshStock",
          "when": "view == dataLensView.stock",
          "group": "navigation"
        },
        {
          "command": "data-lens.sortStock",
          "when": "view == dataLensView.stock",
          "group": "navigation"
        },
        {
          "command": "data-lens.addStock",
          "when": "view == dataLensView.stock",
          "group": "navigation"
        },
        {
          "command": "data-lens.viewFundFlow",
          "when": "view == dataLensView.stock",
          "group": "navigation"
        },
        {
          "command": "data-lens.leekCenterView",
          "when": "view == dataLensView.stock",
          "group": "navigation"
        },
        {
          "command": "data-lens.setStockPrice",
          "when": "view == dataLensView.stock",
          "group": "navigation"
        },
        {
          "command": "data-lens.toggleStockChanges",
          "when": "view == dataLensView.stock",
          "group": "navigation"
        },
        {
          "command": "data-lens.refreshFollow",
          "when": "view == dataLensView.news",
          "group": "navigation"
        },
        {
          "command": "data-lens.toggleFlashNews",
          "when": "view == dataLensView.news",
          "group": "navigation"
        },
        {
          "command": "data-lens.addNews",
          "when": "view == dataLensView.news",
          "group": "navigation"
        },
        {
          "command": "data-lens.refreshBinance",
          "when": "view == dataLensView.binance",
          "group": "navigation"
        },
        {
          "command": "data-lens.addBinancePair",
          "when": "view == dataLensView.binance",
          "group": "navigation"
        },
        {
          "command": "data-lens.binanceSort",
          "when": "view == dataLensView.binance",
          "group": "navigation"
        },
        {
          "command": "data-lens.refreshForex",
          "when": "view == dataLensView.forex",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "data-lens.viewFundHistory",
          "when": "view == dataLensView.fund && viewItem != category",
          "group": "group2"
        },
        {
          "command": "data-lens.viewFundPosition",
          "when": "view == dataLensView.fund && viewItem != category",
          "group": "group2"
        },
        {
          "command": "data-lens.setFundTop",
          "when": "view == dataLensView.fund && viewItem != category  && viewItem!=nodata",
          "group": "group1"
        },
        {
          "command": "data-lens.setFundTop",
          "when": "view == dataLensView.fund && viewItem != category  && viewItem!=nodata",
          "group": "inline"
        },
        {
          "command": "data-lens.addFund",
          "when": "view == dataLensView.fund && viewItem == category",
          "group": "inline"
        },
        {
          "command": "data-lens.deleteFund",
          "when": "view == dataLensView.fund && viewItem != category",
          "group": "group4"
        },
        {
          "command": "data-lens.removeFundGroup",
          "when": "view == dataLensView.fund && viewItem == category",
          "group": "group7"
        },
        {
          "command": "data-lens.renameFundGroup",
          "when": "view == dataLensView.fund && viewItem == category",
          "group": "group7"
        },
        {
          "command": "data-lens.setStockTop",
          "when": "view == dataLensView.stock && viewItem != category  && viewItem!=nodata",
          "group": "group1"
        },
        {
          "command": "data-lens.setStockUp",
          "when": "view == dataLensView.stock && viewItem != category  && viewItem!=nodata",
          "group": "group1"
        },
        {
          "command": "data-lens.setStockDown",
          "when": "view == dataLensView.stock && viewItem != category  && viewItem!=nodata",
          "group": "group1"
        },
        {
          "command": "data-lens.stockTrendPic",
          "when": "view == dataLensView.stock  && viewItem != category && viewItem!=nodata",
          "group": "group2"
        },
        {
          "command": "data-lens.setStockTop",
          "when": "view == dataLensView.stock && viewItem != category && viewItem!=nodata",
          "group": "inline"
        },
        {
          "command": "data-lens.setStockUp",
          "when": "view == dataLensView.stock && viewItem != category && viewItem!=nodata",
          "group": "inline"
        },
        {
          "command": "data-lens.setStockDown",
          "when": "view == dataLensView.stock && viewItem != category && viewItem!=nodata",
          "group": "inline"
        },
        {
          "command": "data-lens.aiStockAnalysis",
          "when": "view == dataLensView.stock && (viewItem == aStock || viewItem == hkStock)",
          "group": "inline"
        },
        {
          "command": "data-lens.deleteStock",
          "when": "view == dataLensView.stock  && viewItem != category",
          "group": "group5"
        },
        {
          "command": "data-lens.addStockToBar",
          "when": "view == dataLensView.stock  && viewItem != category",
          "group": "group6"
        },
        {
          "command": "data-lens.addSectorIndex",
          "when": "view == dataLensView.stock && viewItem == sectorCategory",
          "group": "inline"
        },
        {
          "command": "data-lens.setSectorTop",
          "when": "view == dataLensView.stock && viewItem == sectorIndex",
          "group": "inline"
        },
        {
          "command": "data-lens.setSectorTop",
          "when": "view == dataLensView.stock && viewItem == sectorIndex",
          "group": "group1"
        },
        {
          "command": "data-lens.deleteSectorIndex",
          "when": "view == dataLensView.stock && viewItem == sectorIndex",
          "group": "group5"
        },
        {
          "command": "data-lens.deletePair",
          "when": "view == dataLensView.binance  && viewItem != category",
          "group": "group0"
        },
        {
          "command": "data-lens.setPairTop",
          "when": "view == dataLensView.binance",
          "group": "inline"
        },
        {
          "command": "data-lens.setPairTop",
          "when": "view == dataLensView.binance",
          "group": "group1"
        },
        {
          "command": "data-lens.viewUserTimeline",
          "when": "view == dataLensView.news",
          "group": "group0"
        },
        {
          "command": "data-lens.deleteUser",
          "when": "view == dataLensView.news",
          "group": "group1"
        },
        {
          "command": "data-lens.xuangubaoNews",
          "when": "view == dataLensView.news",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "properties": {
        "leek-fund.stocks": {
          "type": "array",
          "default": [
            "sh000001",
            "sh000300",
            "sh000016",
            "sh000688",
            "hk03690",
            "hk00700",
            "usr_ixic",
            "usr_dji",
            "usr_inx",
            "bond_US10Y",
            "nf_IF0",
            "nf_IH0",
            "nf_IC0",
            "nf_IM0",
            "hf_OIL",
            "hf_CHA50CFD",
            "oi_N225",
            "oi_KS11",
            "oi_TWII"
          ],
          "description": "配置需要监控的股票代码（建议通过界面新增）"
        },
        "leek-fund.stockPrice": {
          "type": "object",
          "default": {},
          "description": "股票持仓金额（不建议手填，格式错误影响功能）"
        },
        "leek-fund.stockHeldTipShow": {
          "type": "boolean",
          "default": false,
          "description": "是否开启股票持仓提示"
        },
        "leek-fund.stockMaLineValueShow": {
          "type": "boolean",
          "default": false,
          "description": "是否在股票侧边栏显示 MA5/MA10/MA20/MA30 均线值"
        },
        "leek-fund.funds": {
          "type": "array",
          "default": [
            [
              "001632",
              "420009",
              "320007",
              "003096",
              "001102",
              "003885",
              "001071",
              "005963"
            ]
          ],
          "description": "配置需要监控的基金代码（建议通过界面新增）"
        },
        "leek-fund.fundGroups": {
          "type": "array",
          "default": [
            "我的基金"
          ],
          "description": "配置基金分组名称（建议通过界面新增）"
        },
        "leek-fund.binance": {
          "type": "array",
          "default": [
            "BTC_USDT",
            "ETH_USDT",
            "EOS_USDT"
          ],
          "description": "配置需要监控的交易对（建议通过界面新增）"
        },
        "leek-fund.stocksRemind": {
          "type": "object",
          "description": "股票涨跌提醒，支持价格、涨跌幅。"
        },
        "leek-fund.statusBarStock": {
          "type": "array",
          "default": [
            "sh000001"
          ],
          "description": "状态栏展示的股票（建议通过界面选择设置，必须是在股票代码已设置存在）"
        },
        "leek-fund.interval": {
          "type": "number",
          "default": 5000,
          "description": "配置轮询请求最新数据的时间间隔，单位：毫秒（最小轮询间隔是3秒）"
        },
        "leek-fund.riseColor": {
          "type": "string",
          "default": "white",
          "description": "股票涨的颜色"
        },
        "leek-fund.fallColor": {
          "type": "string",
          "default": "#C9AD06",
          "description": "股票跌的颜色"
        },
        "leek-fund.hideFundBarItem": {
          "type": "boolean",
          "default": false,
          "description": "是否隐藏基金状态栏"
        },
        "leek-fund.hideStatusBarStock": {
          "type": "boolean",
          "default": false,
          "description": "是否隐藏股票状态栏"
        },
        "leek-fund.hideStatusBar": {
          "type": "boolean",
          "default": false,
          "description": "是否隐藏状态栏"
        },
        "leek-fund.hideStatusBarIcon": {
          "type": "boolean",
          "default": false,
          "description": "是否隐藏状态栏图标"
        },
        "leek-fund.newsUserIds": {
          "type": "array",
          "default": [
            "5124430882",
            "1287305957",
            "1632326933"
          ],
          "description": "雪球用户id（进入雪球用户首页，复制/u/后的数字即可，比如 https://xueqiu.com/u/5124430882 链接的 5124430882）"
        },
        "leek-fund.xueqiuCookie": {
          "type": "string",
          "default": "",
          "description": "由于防爬虫机制，需要用户设置雪球网站cookie"
        },
        "leek-fund.fundAmount": {
          "type": "object",
          "default": {},
          "description": "基金持仓金额（不建议手填，格式错误影响功能）"
        },
        "leek-fund.showEarnings": {
          "type": "number",
          "default": 1,
          "description": "显示/隐藏盈亏（1显示，0隐藏）"
        },
        "leek-fund.iconType": {
          "type": "string",
          "default": "arrow",
          "description": "基金&股票涨跌图标（目前支持两种：arrow 和 food）"
        },
        "leek-fund.fundSort": {
          "type": "number",
          "default": 0,
